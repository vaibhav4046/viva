# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- AssemblyAI (required for live voice) ----
# Default mode "sync" is the verified contract: POST {syncBase}/transcribe,
# multipart audio+config, X-AAI-Model: universal-3-5-pro (WAV/PCM only).
# "event-dictation" uses the hackathon beta endpoint when provided.
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_TRANSCRIPTION_MODE=sync
ASSEMBLYAI_SYNC_BASE_URL=https://sync.assemblyai.com
ASSEMBLYAI_DICTATION_URL=
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com

# ---- Persistence: Postgres → Blob → file (first configured wins) ----
# Example: postgresql://user:pass@host:5432/viva?sslmode=require
# When unset, the app uses a local file-backed JSONL store (dev only —
# ephemeral on serverless; readiness reports it honestly).
# On Vercel the writable directory is /tmp; set explicitly:
#   DATA_DIR=/tmp/.viva-data
DATABASE_URL=
DATA_DIR=.data
# Vercel Blob (durable managed store, private blobs). Issued from the
# dashboard: Storage → viva-data → Connect project (adds this automatically).
BLOB_READ_WRITE_TOKEN=

# ---- Identity (Privy). Optional: /demo works on an isolated demo identity ----
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---- Reasoning provider. Deterministic heuristic is the default. ----
# Option: any OpenAI-compatible endpoint for phrasing (validated, 1 repair max)
AI_PROVIDER=heuristic
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---- Jobs (durable spine) ----
# Tick worker auth: `x-viva-tick: <secret>` or `Authorization: Bearer <secret>`.
# Vercel Cron sends the Bearer form when CRON_SECRET is set (see vercel.json).
VIVA_TICK_SECRET=
CRON_SECRET=

# ---- Demo ----
DEMO_MODE=true
