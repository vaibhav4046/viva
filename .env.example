# Required. Server-side only — this key must never reach the browser.
ASSEMBLYAI_API_KEY=

# The hackathon's beta Dictation endpoint. Leave the defaults unless testing
# a region (dictation.us. / dictation.eu.).
ASSEMBLYAI_DICTATION_URL=https://dictation.assemblyai.com/v1/transcribe/live
ASSEMBLYAI_SYNC_URL=https://sync.assemblyai.com/transcribe
ASSEMBLYAI_TRANSCRIPTION_MODE=dictation   # dictation | sync

# Optional. Postgres (Neon pooled string). Without it the store is
# per-instance and does not survive a redeploy; /api/health/ready reports
# durable:false rather than pretending otherwise.
DATABASE_URL=

# Optional. Without these the heuristic tutor answers and the UI never blanks.
# Gemini through AI Studio's OpenAI-compatible endpoint, or any compatible host.
AI_PROVIDER=openai-compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=

NEXT_PUBLIC_APP_URL=https://viva-five-murex.vercel.app
