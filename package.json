    "test:accessibility": "playwright test",
    "test:routes": "node scripts/check-routes.mjs",
    "lint:copy": "node scripts/lint-copy.mjs",
    "test:extension": "node extension/extract.selftest.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "lucide-react": "^1.45.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
